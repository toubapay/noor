# Backend API (same Laravel API the Flutter app uses)
VITE_API_BASE_URL=https://admin.marcheocass.com

# Google Maps JS API key (Places autocomplete, maps, geocoding on web)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web app config (Firebase console -> Project settings -> Web app)
# NOTE: this is a *separate* app registration from the Android/iOS ones already
# in this repo (android/app/google-services.json, ios/GoogleService-Info.plist).
# Create a Web app under the same Firebase project to get these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Facebook Login (JS SDK) app id
VITE_FACEBOOK_APP_ID=

# Pusher (order/chat realtime updates), see lib/features/chat + order tracking
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
