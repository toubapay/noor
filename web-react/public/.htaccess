# Noor web app — Apache config for GoDaddy shared hosting.
# Deployed under /noor/ (see BASE_PATH in vite.config.ts) — update RewriteBase
# and the RewriteRule target below to match if you move it.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /noor/

  # Let real files/directories (JS, CSS, images, manifest, sw.js, icons) serve
  # as-is; only fall back to the SPA shell for actual page navigations.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Order matters: for a file matching more than one block, Apache's last
# `Header set` wins. The general JS/CSS caching rule comes first so the more
# specific sw.js/manifest no-cache rule (which must win) is declared last.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json image/svg+xml
</IfModule>
